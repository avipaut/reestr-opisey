# Скопировать в .env и заполнить. Без .env — боевые настройки (DEBUG выключен).
DJANGO_ENV=dev
DJANGO_SECRET_KEY=dev-only-change-me
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DB_NAME=reestr
DB_USER=reestr
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5433
# Папки с нормализованными описями (результат модуля коллеги), через «;».
# На сервере — путь UNC: \\server\share\описи
INVENTORY_ROOTS=
